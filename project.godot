; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="CardFight"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

GameData="*res://scripts/autoload/game_data.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
MetaState="*res://scripts/autoload/meta_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
RunState="*res://scripts/autoload/run_state.gd"
SceneRouter="*res://scripts/autoload/scene_router.gd"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.0784314, 0.0862745, 0.121569, 1)
textures/vram_compression/import_etc2_astc=true
